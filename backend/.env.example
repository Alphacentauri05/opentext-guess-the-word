# Application
PROJECT_NAME="OpenText Guess The Word"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
APP_TIMEZONE=UTC

# Database Configuration (PostgreSQL / Supabase)
# For local PostgreSQL:
DATABASE_URL=postgresql://postgres@localhost:5432/opentext_guess_word
# For Supabase PostgreSQL (Transaction Pooler or Direct):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=opentext_guess_the_word_super_secure_jwt_secret_key_2026_demo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Game Rules
MAX_DAILY_GAMES=3
MAX_GUESSES_PER_GAME=5
WORD_LENGTH=5

# CORS Settings (frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
